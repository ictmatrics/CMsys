# Environmental Configuration Template for CMsys (ICTM Framework 4.5)
# Rename to .env and place inside the APP directory

# Application Settings
APP_KEY="cmsys-secret-license-key"
SITE_NAME="CMsys"
APP_VERSION="1.0.1"

# Database Configuration
# Supported connections: mysql, sqlite
DB_CONNECTION="mysql"
DB_HOST="localhost"
DB_USER="root"
DB_PASS=""
DB_NAME="cmsys"

# SQLite Alternative (if DB_CONNECTION="sqlite")
# DB_FILE="APP/Config/database.sqlite"

# Mailer Settings
MAIL_HOST="mail.domain.com"
MAIL_FROM_ADDRESS="no-reply@domain.com"
MAIL_FROM_NAME="CMsys Contact"
MAIL_PORT="465"
MAIL_PASSWORD="password"
